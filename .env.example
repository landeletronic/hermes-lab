# Copy to a local .env file. Never commit the real file.

# Same model in both Hermes instances for a controlled comparison.
OPENAI_MODEL=GPT-5.6-luna
OPENAI_API_KEY=replace-me

# Set independently per stack.
POSTGRES_DB=replace-me
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

# Webapp authentication: use a strong local secret/password.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=replace-me
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-me
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-me
