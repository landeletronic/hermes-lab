# Copy to .env on the host and set POSTGRES_PASSWORD and AUTH_JWT_SECRET.
# This file intentionally contains no credentials.
POSTGRES_PASSWORD=
AUTH_USE_AUTH=false
AUTH_JWT_SECRET=
LLM_OPENAI_API_KEY=ollama
LLM_OPENAI_BASE_URL=http://ollama:11434/v1
EMBEDDING_VECTOR_DIMENSIONS=768
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text:v1.5
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY
DERIVER_ENABLED=true
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=llama3.2:3b
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=128
DERIVER_MAX_INPUT_TOKENS=2048
DERIVER_WORKERS=1
DERIVER_FLUSH_ENABLED=false
DERIVER_REPRESENTATION_BATCH_WORK_UNIT_TARGET_TOKENS=512
DERIVER_POLLING_STARTUP_JITTER_SECONDS=0
